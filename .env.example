# LiveSync Secrets & Environment Variable Template
# Copy this file to .env and fill in your API keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
LIVESYNC_POSTGRES_USERNAME=devuser
LIVESYNC_POSTGRES_PASSWORD=change_this_postgres_password
LIVESYNC_REDIS_PASSWORD=change_this_redis_password
LIVESYNC_JWT_SECRET=change_this_jwt_secret_min_32_bytes
GRAFANA_ADMIN_PASSWORD=change_this_grafana_admin_password
